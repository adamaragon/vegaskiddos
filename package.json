{
  "name": "vegaskiddos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "scrape": "tsx lib/scrape/cli.ts",
    "sweep": "tsx lib/scrape/sweep-cli.ts",
    "translate": "node tools/translate-backfill.mjs",
    "fill-descriptions": "tsx tools/fill-blank-descriptions-cli.ts",
    "geocode": "node tools/geocode-events.mjs",
    "infer-ages": "node tools/infer-ages.mjs",
    "ensure-sub-lang": "node tools/ensure-subscriber-lang.mjs",
    "ensure-fb-fields": "node tools/ensure-fb-fields.mjs",
    "ensure-art-field": "node tools/ensure-art-field.mjs",
    "ensure-cancel-fields": "node tools/ensure-cancel-fields.mjs",
    "check-links": "node tools/check-links.mjs",
    "fb-post": "node tools/fb-post.mjs",
    "fb-repair": "node tools/fb-repair-posts.mjs repair",
    "fb-repair-audit": "node tools/fb-repair-posts.mjs audit",
    "fb-restore-timing": "node tools/fb-repair-posts.mjs restore-timing",
    "gen-art": "node tools/gen-event-art.mjs",
    "ensure-reminders-table": "node tools/ensure-reminders-table.mjs",
    "send-reminders": "node tools/send-reminders.mjs",
    "cf:build": "NEXT_PUBLIC_IMAGE_CDN=https://img.vegaskiddos.com opennextjs-cloudflare build",
    "cf:preview": "NEXT_PUBLIC_IMAGE_CDN=https://img.vegaskiddos.com opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "NEXT_PUBLIC_IMAGE_CDN=https://img.vegaskiddos.com opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^15.5.18",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "three": "^0.171.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@types/leaflet": "1.9.12",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@types/three": "^0.171.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.4.20",
    "postcss": "^8.5.15",
    "puppeteer": "^25.1.0",
    "tailwindcss": "3.4.17",
    "tsx": "^4.22.3",
    "typescript": "5.7.3",
    "wrangler": "^4.98.0"
  }
}
